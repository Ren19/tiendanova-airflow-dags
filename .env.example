# Copia este archivo a ".env" (sin ".example") antes de correr docker compose.
# ".env" esta en .gitignore a proposito: nunca subas credenciales reales a Git.

# UID con el que corren los contenedores (evita problemas de permisos sobre
# los volumenes montados). En Windows deja 50000. En Linux/Mac corre:
#   echo -e "AIRFLOW_UID=$(id -u)"
# y usa ese valor.
AIRFLOW_UID=50000

# Usuario admin que crea airflow-init la primera vez.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Clase 7: credenciales de Snowflake que profiles.yml lee con env_var() ---
SNOWFLAKE_ACCOUNT=tu_cuenta.region
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
